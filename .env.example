# Copy to .env (gitignored). Read by brain/ and node/ via python-dotenv.
# The dashboard has its own dashboard/.env.local (see below).
BROKER_HOST=127.0.0.1
BROKER_PORT=1883
BROKER_WS_PORT=9001
BRAIN_PORT=8000
BRAIN_URL=http://127.0.0.1:8000
DASHBOARD_URL=http://127.0.0.1:3000
DB_PATH=brain/data/ghost.db
EVIDENCE_DIR=brain/data/evidence
EVIDENCE_TTL_DAYS=7
AUTO_SEAL_MIN_SEVERITY=high
OLLAMA_URL=http://127.0.0.1:11434
NARRATOR_MODEL=moondream
NLRULE_MODEL=qwen3:4b
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ROLE_TOKENS=security:sec-123,warden:war-123,privacy:priv-123
NODE_MODEL=yolo26n-pose.pt
DEBUG=0

# --- dashboard/.env.local ---
# Replace localhost with the brain's LAN IP for phones / other laptops.
# NEXT_PUBLIC_BRAIN_URL=http://localhost:8000
# NEXT_PUBLIC_MQTT_WS_URL=ws://localhost:9001
